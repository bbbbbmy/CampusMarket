<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    CampusMarket 后端父工程（Maven multi-module）。
    本轮：仅 campus-common / campus-user / campus-listing / campus-trade；
    campus-gateway / campus-file / campus-notification / admin-bff 见 v0.2。
  -->
  <groupId>com.campus</groupId>
  <artifactId>campus-market-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>campus-common</module>
    <module>campus-user</module>
    <module>campus-listing</module>
    <module>campus-trade</module>
    <module>campus-app</module>
  </modules>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 锁定各业务模块的版本 -->
      <dependency>
        <groupId>com.campus</groupId>
        <artifactId>campus-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.campus</groupId>
        <artifactId>campus-user</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.campus</groupId>
        <artifactId>campus-listing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.campus</groupId>
        <artifactId>campus-trade</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- 测试 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-test</artifactId>
        <version>3.3.5</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
